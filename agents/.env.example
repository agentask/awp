# Used by `docker compose` (agents/docker-compose.yml) for variable
# substitution — copy to agents/.env. Not read by the agents themselves
# when run natively; each of go/, python/, rust/ has its own .env.example
# for that (see each directory's README.md).

# Required: get a key at https://console.x.ai/
XAI_API_KEY=

# Optional: override the Grok model (default: grok-4-fast)
# AWP_MODEL=grok-4-fast

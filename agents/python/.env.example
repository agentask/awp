# Copy to .env and fill in — demo.py, agent_a/main.py, and agent_b/main.py
# all load it automatically (python-dotenv). Every agent turn is a real
# Gemini call; there is no offline/mock mode.

# Option 1: Gemini Developer API (simplest — get a key at
# https://ai.google.dev/gemini-api/docs/api-key)
GOOGLE_API_KEY=

# Option 2: Vertex AI instead — leave GOOGLE_API_KEY unset, uncomment below,
# and make sure `gcloud auth application-default login` has been run.
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# Optional: override the Gemini model both agents use (default: gemini-2.5-flash)
# AWP_MODEL=gemini-2.5-flash

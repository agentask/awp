# Copy to .env and fill in — concierge/config.py loads it automatically
# (python-dotenv), if present; plain exported env vars work too. Every
# agent turn is a real xAI Grok call; there is no offline/mock mode.

# Required: get a key at https://console.x.ai/
XAI_API_KEY=

# Optional: override the Grok model (default: grok-4-fast)
# AWP_MODEL=grok-4-fast

# Optional: this agent's own listen port and domain (defaults shown)
# AWP_SELF_PORT=8002
# AWP_SELF_DOMAIN=concierge.local

# Optional: static domain -> base URL map, standing in for real DNS on
# these *.local demo domains (default shown covers the 3-agent triangle:
# trip-planner.local (Go, :8001) and activities.local (Rust, :8003))
# AWP_PEERS=trip-planner.local=http://127.0.0.1:8001,activities.local=http://127.0.0.1:8003

# Optional: the host peers use to reach THIS agent's inbox (baked into the
# self-signed index). Default 127.0.0.1 is correct for native runs on one
# machine; under docker compose it's set to this service's own name
# instead (see ../docker-compose.yml) since a peer container can't reach
# another container via 127.0.0.1.
# AWP_ADVERTISE_HOST=127.0.0.1
